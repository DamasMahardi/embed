# ============================================================
# PHP Crawler -> /parse -> /embed  (worker-ingest)
# Copy file ini menjadi .env lalu sesuaikan bila perlu.
# ============================================================

APP_TIMEZONE=Asia/Jakarta

# Base URL service worker-ingest (FastAPI)
INGEST_SERVICE_URL=http://localhost:8001
INGEST_SERVICE_TOKEN=
INGEST_CONNECT_TIMEOUT=10
INGEST_PARSE_TIMEOUT=600
INGEST_PARSE_MAX_PAGES=500
# Batas waktu satu permintaan /embed (detik). BGE-M3 di CPU bisa sangat lambat
# (chunk 12000 karakter bisa menembus 60 detik per chunk); permintaan yang
# kehabisan waktu DIULANG. Naikkan nilai ini atau turunkan
# EMBED_MAX_CHARS_PER_BATCH bila batch masih lebih lama.
INGEST_EMBED_TIMEOUT=300
INGEST_RETRIES=3
INGEST_RETRY_DELAY_MS=1000

# Browser crawler
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
CRAWLER_REQUEST_TIMEOUT=60
# Batas waktu TAHAP KONEKSI (detik). Sebagian situs .go.id mengumumkan beberapa
# alamat A dan sebagian alamatnya membuang paket (firewall), sehingga curl
# menunggu sampai batas ini habis walaupun alamat lain sehat - misalnya
# dukcapil.kemendagri.go.id: 118.97.79.23 tidak menjawab, 36.66.118.179 normal.
CRAWLER_CONNECT_TIMEOUT=10
# true (bawaan) = unduhan yang gagal pada TAHAP KONEKSI dicoba ULANG ke alamat
# IP lain hasil resolusi host yang sama (CURLOPT_RESOLVE; Host/SNI tetap nama
# host sehingga verifikasi TLS tidak berubah), lalu alamat yang berhasil dipakai
# untuk sisa run. Dicatat pada log sebagai tahap ADDR_RETRY.
# false = perilaku lama: satu percobaan saja, unduhan gagal bila alamat pertama
# tidak menjawab.
CRAWLER_RETRY_ADDRESSES=true
CRAWLER_MAX_BYTES=5242880
# Batas ukuran unduhan untuk URL DOKUMEN (berkas .pdf/.docx/.xlsx/...). Berkas
# APBD/LPPD bisa puluhan MB, jadi batasnya dipisah dari CRAWLER_MAX_BYTES.
CRAWLER_DOCUMENT_MAX_BYTES=67108864
# CRAWLER_FOLLOW_DOCUMENT_LINKS=true => tautan berkas dokumen (.pdf/.docx/.xlsx)
# yang ditemukan pada halaman web ikut di-crawl dan diproses dalam MODE DOKUMEN:
# berkasnya diunduh apa adanya lalu dikirim ke /parse (parser dipilih dari
# ekstensi berkas, mis. parse_pdf.py). Lampiran tetap harus satu host dengan
# halaman (same_host_only) dan ikut menghabiskan kuota halaman/permintaan.
# Tautan dokumen diprioritaskan di depan antrean (tidak kalah kuota dari
# halaman daftar), pratinjau <object data>/<embed src>/<iframe src> ikut
# dikenali, dan endpoint unduhan tanpa ekstensi ("/unduh?id=12",
# "/path/download/12") diikuti dengan jenis berkas ditentukan dari
# Content-Type, Content-Disposition, atau isi berkas (octet-stream sekalipun).
# false (bawaan) = tautan dokumen dilewati; PDF hanya terambil dari entri
# dokumen di config/sites.json.
CRAWLER_FOLLOW_DOCUMENT_LINKS=false
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_DELAY_MS=1000
CRAWLER_SAVE_HTML=true
# true (bawaan) = berkas DOKUMEN mentah (pdf/docx/xlsx) yang vektornya sudah
# terkirim ke Qdrant DIHAPUS dari storage/documents supaya tidak menumpuk dan
# tidak menghabiskan penyimpanan. Markdown, payload Qdrant, dan berkas vektor
# (.jsonl/.qdrant.json) tetap tersimpan sehingga isi dokumen masih bisa dicari.
# Penghapusan hanya setelah push Qdrant site itu selesai (QDRANT_PUSH_AFTER_CRAWL
# atau --push-qdrant); dokumen yang gagal diparse/di-embed TIDAK dihapus supaya
# masih bisa diproses ulang TANPA crawl ulang dengan perintah:
#   php bin/crawl.php documents --site=<id> [--push-qdrant]
# (URL asli berkas dipulihkan dari document_id pada namanya; lihat --help).
# Per entri sites.json:
# "delete_documents_after_push": false.
CRAWLER_DELETE_DOCUMENTS_AFTER_PUSH=true
# PENEMUAN BERKAS DOKUMEN OTOMATIS (bawaan: aktif). Halaman yang dirender browser
# headless dicatat log jaringannya (Chrome NetLog) sehingga tautan unduhan yang
# TIDAK ADA di HTML (dibuat JavaScript dari API, mis. halaman /informasi-publik
# Kemendagri) tetap ditemukan: URL berkas yang diminta halaman langsung
# diantrekan, dan endpoint JSON yang dipanggil halaman dipanggil ulang (GET saja)
# lalu isinya ditelusuri; path relatif diselesaikan ke basis yang benar dengan
# probe HEAD (mis. https://backend.kemendagri.go.id/uploads). Hasilnya: berkas
# diunduh -> /parse -> /embed -> Qdrant tanpa aturan per situs. Endpoint
# pelacakan (analytics/visitor-track) dan host pihak ketiga tidak dipanggil.
# CRAWLER_AUTO_DOCUMENTS_MAX  = batas jumlah berkas per halaman (200).
# CRAWLER_AUTO_DOCUMENTS_APIS = batas endpoint API dipanggil ulang per halaman (8).
# Per entri sites.json: "auto_documents": false. Log: DOC_AUTO / DOC_AUTO_QUEUE.
CRAWLER_AUTO_DOCUMENTS=true
CRAWLER_AUTO_DOCUMENTS_MAX=200
CRAWLER_AUTO_DOCUMENTS_APIS=8
# TLS: sebagian situs .go.id mengirim rantai sertifikat tidak lengkap (hanya
# sertifikat leaf) sehingga curl gagal "unable to get local issuer certificate".
# CRAWLER_INSECURE_RETRY=true => crawler mencoba ulang tanpa verifikasi untuk
# host tersebut dan mencatatnya di log txt (tahap TLS_INSECURE).
# CRAWLER_CA_BUNDLE diisi path cacert.pem bila ingin CA sendiri.
CRAWLER_VERIFY_TLS=true
CRAWLER_INSECURE_RETRY=true
CRAWLER_CA_BUNDLE=

# Batas TOTAL permintaan (unduhan halaman) untuk SATU run crawl, dihitung
# lintas semua site. 0 = tanpa batas (BAWAAN) supaya crawl bisa maksimal; isi
# nilai > 0 hanya bila ingin membatasi. Bisa ditimpa per run:
# php bin/crawl.php crawl --max-requests=200
MAX_REQUESTS_PER_CRAWL=0
# Jumlah halaman yang diunduh BERSAMAAN dalam satu batch (curl_multi).
# 1 = satu per satu (jeda antar permintaan per URL); >1 = jeda berlaku antar
# batch, jadi pakai nilai kecil untuk web yang sensitif.
CRAWL_CONCURRENCY=5
# Batas halaman per site untuk site yang tidak menulis "max_pages":
# 0 = TANPA BATAS (BAWAAN) supaya semua halaman & berkas dokumen yang ditemukan
# diproses sampai antrean habis. Isi nilai > 0 hanya bila ingin membatasi
# (mis. uji coba cepat); bisa ditimpa per run lewat kolom "Batas halaman / site"
# pada dashboard atau opsi --max-pages=50.
CRAWL_MAX_PAGES=0
# Kedalaman tautan default untuk site yang tidak menulis "max_depth":
# 0 = hanya start_urls, 1 = boleh ikut tautan dari start_urls, dst.
CRAWL_MAX_DEPTH=0
# Sakelar GLOBAL "follow_links": nilai bawaan untuk semua site yang tidak
# menulis "follow_links" pada config/sites.json. true = crawler mengikuti
# tautan halaman sampai max_depth site; false = hanya start_urls. Entri site,
# opsi CLI --follow/--no-follow, dan centang "Ikuti tautan" pada UI menimpanya.
CRAWLER_FOLLOW_LINKS=true

# Chunking (karakter). 12000/1200 = satu point memuat konteks lebih banyak
# (mis. satu bagian dokumen PDF). Bisa ditimpa per entri sites.json.
CHUNK_SIZE=12000
CHUNK_OVERLAP=1200
CHUNK_MIN_LENGTH=50
# Pembersihan markdown hasil /parse: menu navigasi, ornament, dan footer dibuang
# sebelum di-chunk, sehingga isi yang dikirim ke /embed (dan point Qdrant)
# benar-benar isi halaman. Per entri sites.json: "clean_markdown": false.
CHUNK_CLEAN_MARKDOWN="true"
# Batas rasio markup tautan per chunk (0.0-1.0). Chunk yang mayoritas tautan
# (menu/daftar isi) tidak dikirim ke /embed. 1 = tanpa batas.
CHUNK_MAX_LINK_RATIO="0.6"
# Isi halaman yang identik/mirip dengan URL lain pada site yang sama hanya
# dikirim sekali ke /embed (ciri situs berbasis JavaScript yang isinya baru
# dibuat di browser). Per entri sites.json: "drop_duplicate_content": false.
CHUNK_DROP_DUPLICATE_CONTENT="true"
# Batas kemiripan isi yang dianggap sama (0.0-1.0). 0.85 = dua halaman dianggap
# boilerplate bila 85% katanya sama; 1.0 = hanya isi yang persis identik.
CHUNK_DUPLICATE_SIMILARITY="0.85"

# Render halaman berbasis JavaScript dengan browser headless (Chrome/Edge) yang
# ada di mesin. Crawler merender halaman kerangka SPA lebih dahulu sehingga isi
# halaman sebenarnya ikut terbaca - tidak perlu aturan API per situs.
#   off    = tidak pernah merender (HTML hasil unduhan apa adanya)
#   auto   = hanya halaman yang terdeteksi kerangka JavaScript (bawaan)
#   always = setiap halaman HTML dirender (lebih lambat, +/- 3-6 detik/halaman)
CRAWLER_JS_RENDER="auto"
# Path biner browser; kosong = deteksi otomatis (Chrome lalu Edge/Chromium).
# Isi "none" untuk mematikan render tanpa mengubah mode di atas.
CRAWLER_BROWSER=
# Waktu (ms) yang diberikan browser untuk menjalankan JavaScript + mengambil data
# sebelum DOM diambil (--virtual-time-budget).
CRAWLER_BROWSER_WAIT=6000
# Batas proses browser per halaman (ms).
CRAWLER_BROWSER_TIMEOUT=25000
# Argumen tambahan dipisah spasi, mis. --ignore-certificate-errors bila situs
# mengirim rantai TLS tidak lengkap.
CRAWLER_BROWSER_FLAGS=
# UA browser headless; kosong = UA Chrome bawaan (situs sering memblokir
# "HeadlessChrome", jadi nilai kosong tetap aman).
CRAWLER_BROWSER_UA=
# Ambang deteksi halaman kerangka: teks terlihat < CRAWLER_RENDER_MIN_TEXT
# karakter DAN ada penanda SPA / rasio teks-ke-HTML < CRAWLER_RENDER_MAX_TEXT_RATIO.
CRAWLER_RENDER_MIN_TEXT=2000
CRAWLER_RENDER_MAX_TEXT_RATIO="0.03"
# Umur maksimal (jam) sisa berkas sementara render (folder profil Chrome, DOM,
# NetLog) sebelum dibersihkan otomatis. Proses yang berhenti mendadak (galat
# fatal / dihentikan paksa) tidak sempat membersihkan sendiri sehingga folder
# profil browser (puluhan MB per render) menumpuk di folder temp sistem; setiap
# run menyapu sisa yang lebih tua dari batas ini. Pembersihan manual:
# php bin/crawl.php temp --umur=1
CRAWLER_RENDER_TEMP_HOURS=6
# Jeda/lanjutkan job dari dashboard: proses CLI memeriksa berkas
# storage/jobs/<job-id>.pause di titik aman (antar batch halaman / antar site)
# setiap CRAWLER_PAUSE_POLL_MS milidetik, lalu menunggu sampai berkasnya
# dihapus. Batch yang sedang berjalan diselesaikan lebih dahulu sehingga tidak
# ada unduhan yang terpotong.
CRAWLER_PAUSE_POLL_MS=1000
# Pengulangan OTOMATIS bila run gagal FATAL (proses mati di tengah run, mis.
# galat tak tertangani). Job lama tetap tersimpan sebagai GAGAL beserta lognya;
# job baru dibuat dengan site + opsi yang sama dan ditautkan lewat kolom
# ulangi_dari/ulangi_ke. 0 = mati. Pengulangan manual selalu tersedia:
# tombol "Ulangi job" pada dashboard atau
# php bin/crawl.php retry --job=<job-id>
CRAWLER_AUTO_RETRY=1

# Embedding (BGE-M3 = 1024 dimensi)
EMBED_BATCH_SIZE=8
# Batas TOTAL karakter per permintaan /embed: batch dipotong lebih awal bila
# totalnya menembus batas ini supaya permintaan tidak melewati
# INGEST_EMBED_TIMEOUT (chunk 12000 karakter). 0 = tanpa batas.
EMBED_MAX_CHARS_PER_BATCH=40000
EMBED_DIMENSION=1024
EMBED_STORE_VECTORS=true

# Tujuan Qdrant untuk perintah `php bin/crawl.php qdrant` (unggah berkas vektor
# storage/vectors/<site>/<run-id>.jsonl). Selalu cek dulu dengan --dry-run atau
# ekspor --out=... bila ingin unggah manual.
#
# QDRANT_URL       : base URL REST Qdrant (mis. cloud/server sendiri).
# QDRANT_API_KEY   : dikirim sebagai header api-key; kosongkan bila Qdrant lokal
#                    tanpa autentikasi.
# QDRANT_COLLECTION: nama collection tujuan (mis. lensawarga_documents).
# QDRANT_TIMEOUT   : timeout permintaan ke Qdrant. Menerima DETIK bila nilainya
#                    < 1000 (120 = 120 detik) atau MILIDETIK bila >= 1000
#                    (10000 = 10 detik) supaya .env gaya Node/JS bisa dipakai.
# QDRANT_VECTOR_SIZE: dimensi vektor collection (BGE-M3 = 1024). Dipakai untuk
#                    MEMBUAT collection baru dan MEMVALIDASI dimensi berkas
#                    vektor sebelum dikirim, sehingga collection tidak pernah
#                    dibuat dengan dimensi yang salah. 0 = ikut berkas vektor.
# QDRANT_DISTANCE  : Cosine | Euclid | Dot | Manhattan.
# QDRANT_RECREATE  : false = collection dipastikan ada (dibuat bila belum ada,
#                    dibiarkan bila sudah ada); true = hapus lalu buat ulang.
#                    Menulis QDRANT_RECREATE pada .env sudah dianggap sebagai
#                    izin mengurus collection tanpa harus --create.
# QDRANT_PUSH_AFTER_CRAWL: true (bawaan) = perintah `crawl` LANGSUNG mengunggah
#                    hasil /embed ke Qdrant begitu tiap site selesai, jadi tidak
#                    perlu menjalankan `php bin/crawl.php qdrant` manual.
#                    Kegagalan unggah tidak menggagalkan crawl (dicatat
#                    QDRANT_PUSH pada log + ringkasan, bisa diulang manual).
#                    Matikan: false, atau sekali run: --no-push-qdrant
#                    (paksa aktif sekali run: --push-qdrant).
# QDRANT_AUTO_CREATE: true = boleh membuat collection bila belum ada (alternatif
#                    QDRANT_RECREATE=false + --create). Bila tidak ingin ada
#                    collection baru dibuat otomatis, hilangkan QDRANT_RECREATE
#                    dan biarkan variabel ini false.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_DISTANCE=Cosine
QDRANT_API_KEY=
QDRANT_BATCH_SIZE=64
QDRANT_TIMEOUT=120
QDRANT_VECTOR_SIZE=1024
QDRANT_RECREATE=false
QDRANT_PUSH_AFTER_CRAWL=true
QDRANT_RETRIES=3
QDRANT_RETRY_DELAY_MS=1000
# (bawaan lama) auto_create=false: collection harus sudah ada (dibuat dengan
# --create atau lewat dashboard) agar dimensi tidak dibuat keliru tanpa disadari.
QDRANT_AUTO_CREATE=false
# true = setiap run yang menghasilkan vektor juga menulis SATU berkas
# storage/vectors/<site>/<run-id>.qdrant.json berisi
# {"collection_name":"documents","wait":true,"points":[{"id":...,"vector":[...],"payload":{...}}]}
# yang bisa langsung dikirim: Invoke-RestMethod -Method Put -InFile <berkas> ...
QDRANT_EXPORT_JSON=true
# Batas point untuk satu berkas JSON (0 = tanpa batas). Bila terlampaui, ekspor
# dilewati (QDRANT_EXPORT DILEWATI) dan run diunggah bertahap via CLI/--out.
QDRANT_EXPORT_MAX_POINTS=10000

# Parse: /parse dipakai lebih dulu (markdown kaya via Docling); parser lokal
# hanya cadangan. Service WAJIB dijalankan dengan EMBED_WEB_PAGE=true (dan
# di-restart setelah .env-nya diubah); bila tidak, /parse menolak HTML (HTTP 422
# "web ingestion disabled") dan crawler turun ke parser lokal.
PARSE_FALLBACK_LOCAL=true
# PARSE_TRY_SERVICE=false => lewati /parse sepenuhnya (log PARSE_SKIP), langsung
# parser lokal. Pakai hanya bila service tidak bisa di-set EMBED_WEB_PAGE=true.
PARSE_TRY_SERVICE=true

# Log txt
LOG_ENABLED=true
LOG_DAILY_MASTER=true
LOG_PER_RUN=true
LOG_PER_SITE=true
LOG_CONSOLE=true

# Web UI (Laragon)
UI_ENABLED=true
UI_LOCALHOST_ONLY=true

# Biner PHP CLI untuk melepas job crawler di latar belakang (opsional).
# Diisi HANYA bila deteksi otomatis salah, mis. UI dibuka lewat Apache mod_php
# atau php-cgi sehingga PHP_BINARY bukan php.exe.
# Contoh Windows: C:\laragon\bin\php\php-8.3.30-Win32-vs16-x64\php.exe
# Contoh Linux   : /usr/bin/php
CRAWLER_PHP_BINARY=
